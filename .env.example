# ==========================================
# Contoh variabel environment konfigurasi MUSE2API
# Salin menjadi .env agar berlaku: cp .env.example .env
# ==========================================

# [Wajib/Opsional] Kunci autentikasi admin & API (diawali m2a_).
# Jika dikosongkan, program akan otomatis membuat kunci acak berkekuatan tinggi saat pertama kali dijalankan dan mencetaknya ke log konsol.
MUSE2API_KEY=m2a_your_secret_admin_key_here

# Alamat dan port yang didengarkan layanan (di dalam container Docker harus diatur ke 0.0.0.0)
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Alamat akses publik eksternal (untuk klien downstream dan halaman admin dalam merangkai URL, mis. https://api.yourdomain.com)
# Jika dikosongkan, halaman admin akan otomatis memakai host dan port dari browser yang sedang mengakses
MUSE2API_PUBLIC_BASE=

# Path file executable browser Chromium
# Linux/Docker biasanya /usr/bin/chromium atau /usr/bin/chromium-browser
# Untuk menjalankan lokal di Windows, isi path lengkap Chrome atau kosongkan agar dicari otomatis
MUSE2API_CHROMIUM=/usr/bin/chromium

# Port komunikasi remote debugging CDP
MUSE2API_CDP_PORT=19210

# Pengaturan timeout tugas (satuan: detik)
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Jumlah maksimum tugas pembuatan yang berjalan bersamaan (bisa dinaikkan sesuai sumber daya server, default 2)
MUSE2API_CONCURRENCY=2

# Apakah akun yang dinonaktifkan di latar belakang tetap dijalankan keep-alive otomatis (0=mati, 1=nyala)
# Jika dinyalakan, akun yang sudah dinonaktifkan tetap menjalankan keep-alive diam-diam dan perpanjangan sesi, tetapi tidak ikut dirutekan untuk pembuatan dan percakapan normal
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Sakelar keamanan gambar referensi (default aman; hanya deployment satu pengguna tepercaya yang boleh mempertimbangkan untuk mengatur 1 secara eksplisit)
# 1: mengizinkan permintaan API membaca path file lokal server
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1: mengizinkan permintaan API mengunduh URL intranet/lokal; jika 0, setiap hop diperiksa dan hanya IP publik yang diizinkan
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0
